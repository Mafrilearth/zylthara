generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  STUDENT
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum Section {
  LISTENING
  STRUCTURE
  READING
}

enum AttemptStatus {
  IN_PROGRESS
  FINISHED
  EXPIRED
  ABANDONED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(STUDENT)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  auditLogs     AuditLog[]
  bookings      Booking[]
  attempts      Attempt[]

  @@index([email])
  @@index([role])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?  @db.Uuid
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Schedule {
  id          String    @id @default(uuid()) @db.Uuid
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  location    String
  quota       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  bookings    Booking[]
  attempts    Attempt[]

  @@index([date])
}

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId  String        @db.Uuid
  schedule    Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  status      BookingStatus @default(CONFIRMED)
  ticketCode  String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@unique([userId, scheduleId])
  @@index([userId])
  @@index([scheduleId])
  @@index([ticketCode])
}

model Passage {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  content   String    @db.Text
  section   Section
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  questions Question[]

  @@index([section])
}

model Question {
  id        String    @id @default(uuid()) @db.Uuid
  passageId String?   @db.Uuid
  passage   Passage?  @relation(fields: [passageId], references: [id], onDelete: Cascade)
  section   Section   @default(STRUCTURE)
  text      String    @db.Text
  options   Json
  answerKey String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  answers   Answer[]

  @@index([section])
  @@index([passageId])
}

model Attempt {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId  String        @db.Uuid
  schedule    Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  answers     Answer[]

  @@index([userId])
  @@index([scheduleId])
}

model Answer {
  id         String    @id @default(uuid()) @db.Uuid
  attemptId  String    @db.Uuid
  attempt    Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String    @db.Uuid
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}
