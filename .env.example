# Neon PostgreSQL Connection URLs
# App runtime (connection pooler)
DATABASE_URL="postgresql://user:password@ep-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Prisma CLI migrations (direct compute endpoint)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon Managed Better Auth
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="secret-at-least-32-characters-long"
